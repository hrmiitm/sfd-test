# Default gateway: LLM Foundry's OpenRouter endpoint.
LLMFOUNDRY_BASE_URL=https://llmfoundry.straivedemo.com
LLMFOUNDRY_API_KEY=
# Existing Foundry setups may use this alias instead:
LLMFOUNDRY_TOKEN=


# example1: https://llmfoundry.straivedemo.com/openrouter/v1/chat/completions

# Embedding-only pipeline; no chat/completions requests are made.
# Override the full URL if your proxy exposes a different embeddings route.
LLMFOUNDRY_EMBEDDINGS_URL=https://llmfoundry.straivedemo.com/openrouter/v1/embeddings
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Leave URL empty for embedded local Qdrant (small development runs).
# For the full corpus, run Qdrant server and set http://localhost:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional benchmark chat route override (otherwise derived from base URL).
LLMFOUNDRY_CHAT_URL=https://llmfoundry.straivedemo.com/openrouter/v1/chat/completions
